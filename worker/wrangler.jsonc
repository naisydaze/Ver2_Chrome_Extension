{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "v2-quote-api",
	"main": "src/index.js",
	"compatibility_date": "2026-10-30",
	"observability": {
		"enabled": true
	},
	"ai": {
		"binding": "AI"
	},
	"triggers": {
		"crons": ["15 0,12 * * *"]
	},
	"durable_objects": {
		"bindings": [{ "name": "SCHEDULE_GUARD", "class_name": "ScheduleGuard" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["ScheduleGuard"] }],
	"kv_namespaces": [
		{
			"binding": "QUOTE_CACHE",
			"id": "144989d2bf47475dac141d21ac8cf551"
		},
		{
			"binding": "QUOTE_STAGING",
			"id": "dd3da500108e49e59b681f950d2aaab3"
		}
	],
	"ratelimits": [
		{
			"name": "INSTALL_RATE_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 10,
				"period": 60
			}
		},
		{
			"name": "IP_RATE_LIMITER",
			"namespace_id": "1002",
			"simple": {
				"limit": 120,
				"period": 60
			}
		}
	],
	"vars": {
		"ALLOWED_EXTENSION_ORIGIN": "chrome-extension://igonfkldenaeailncliahdblmcmnnoci",
		"DEV_EXTENSION_ORIGIN": "chrome-extension://afoiegbmhabcempeoklhjkgaaacdcoml",
		"BATCH_SIZE": "20"
	}
}
